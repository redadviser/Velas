{
  "name": "velas-backend",
  "version": "1.0.0",
  "description": "API da app Velas (aniversários) — Fastify + PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/core/migrations.ts",
    "migrate:prod": "node dist/core/migrations.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "caprover:tar": "COPYFILE_DISABLE=1 tar -cf caprover.tar captain-definition Dockerfile .dockerignore package.json package-lock.json tsconfig.json src migrations",
    "caprover:deploy": "npm run caprover:tar && npx caprover deploy -t caprover.tar",
    "mail:test": "tsx src/core/mail-test.ts"
  },
  "type": "module",
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
