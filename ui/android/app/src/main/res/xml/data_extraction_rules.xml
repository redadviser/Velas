<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada da app vai para a cópia na nuvem nem passa para outro
     telemóvel. Os dados estão no servidor e voltam ao entrar na conta; o
     token da sessão (FlutterSecureStorage) só funciona no aparelho onde foi criado. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
