<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo do widget: o gradiente da marca, com o brilho suave no canto de cima. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="315"
                android:startColor="#FFF05560"
                android:centerColor="#FFE662A8"
                android:endColor="#FFAB8BE3" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:type="radial"
                android:centerX="0.15"
                android:centerY="0"
                android:gradientRadius="160dp"
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
